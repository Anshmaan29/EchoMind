# EchoMind Core Configuration
PROJECT_NAME=EchoMind
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=echomind_user
POSTGRES_PASSWORD=echomind_password
POSTGRES_DB=echomind_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://echomind_user:echomind_password@postgres:5432/echomind_db

# Vector Store Configuration (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=echomind_memories

# Embedding Provider Configuration
# Options: mock, openai, sentence-transformers, nomic, qwen
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
OPENAI_API_KEY=
